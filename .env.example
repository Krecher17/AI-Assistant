# Copy this file to .env. Never commit credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
PORT=4317
# Optional Gmail OAuth (Google Cloud Desktop application client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional ElevenLabs voice; browser speech is available without this.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
